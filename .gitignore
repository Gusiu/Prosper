# Lightning artifacts. predict/tft.py disables the logger and checkpointing so
# these should no longer appear; kept as a guard because leaving them on once
# produced ~18k directories and 260 MB in the repo root.
checkpoints/
lightning_logs/

# Generated JSON artifacts live under data/ (already ignored above).
# A bare `*.json` rule used to sit here; it also swallowed tooling config
# such as .claude/settings.json, so keep any new rule scoped to a path.

# AI Agent Memory Bank (local only, not for git)
.ai-memory/

# Local-only working notes and editor/agent scratch files.
CLAUDE.md
AGENTS.md
.claude/

# The technical write-up is generated from the project's own artifacts by
# `scripts/build_documentation.py`, which is the tracked source of truth. The
# document itself is an output: the previous tracked copy drifted until it
# described horizons, a feature set and findings that three later fixes
# overturned, and anyone reading the repository took it for the current design.
docs/*.pdf
docs/*.docx

# Figures rendered by scripts/documentation_figures.py at build time. The
# script is the source; the PNGs are outputs, like the document itself.
data/_figures/

# Screenshots supplied by hand for chapter 11.6. Material for the document, not
# code; the slots in scripts/build_documentation.py are the tracked part.
docs/zrzuty/*.png
docs/zrzuty/*.jpg
