# Lightning artifacts. predict/tft.py disables the logger and checkpointing so
# these should no longer appear; kept as a guard because leaving them on once
# produced ~18k directories and 260 MB in the repo root.
checkpoints/
lightning_logs/

# Generated JSON artifacts live under data/ (already ignored above).
# A bare `*.json` rule used to sit here; it also swallowed tooling config
# such as .claude/settings.json, so keep any new rule scoped to a path.

# AI Agent Memory Bank (local only, not for git)
.ai-memory/

# Local-only working notes and editor/agent scratch files.
CLAUDE.md
AGENTS.md
.claude/

# The technical write-up is generated from results that keep moving, so it does
# not belong in the tree: the tracked copy described horizons, a feature set and
# a set of findings that three later fixes overturned, and anyone reading the
# repository would have taken it for the current design.
docs/*.pdf
